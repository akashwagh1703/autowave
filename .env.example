# -----------------------------------------------------------------------------
# AutoWave environment template.
# Every variable is documented in docs/09-devops/environment.md.
# Never commit real secrets. Production values live only on the server.
# -----------------------------------------------------------------------------

# --- Application --------------------------------------------------------------
APP_NAME=AutoWave
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://app.autowave.localhost:8000

# --- AutoWave hosts (ADR-007) ---------------------------------------------------
# Marketing site, business app and Super Admin are separate hosts. Every other
# host is resolved through the `domains` table as a tenant website.
# *.localhost resolves to 127.0.0.1 in modern browsers; no hosts-file edits needed.
AUTOWAVE_ROOT_DOMAIN=autowave.localhost
AUTOWAVE_MARKETING_HOST=autowave.localhost
AUTOWAVE_APP_HOST=app.autowave.localhost
AUTOWAVE_ADMIN_HOST=admin.autowave.localhost
# Seconds a host -> tenant lookup is cached.
AUTOWAVE_DOMAIN_CACHE_TTL=600

# First platform administrator (PlatformAdminSeeder). Leave the password empty
# to have a random one generated and printed once.
AUTOWAVE_ADMIN_NAME="AutoWave Admin"
AUTOWAVE_ADMIN_EMAIL=admin@autowave.in
AUTOWAVE_ADMIN_PASSWORD=
AUTOWAVE_MAX_BUSINESSES_PER_USER=3
AUTOWAVE_DEFAULT_COUNTRY_CODE=91

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Logging ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL) ----------------------------------------------------
# Local: provided by docker-compose.yml. Tests use DB_DATABASE=autowave_testing (see phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=autowave
DB_USERNAME=autowave
DB_PASSWORD=secret

# Host ports used by docker-compose.yml (change if 5432/6379 are taken locally).
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379

# --- Session ------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# --- Broadcasting / Filesystem ------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Uploaded images (logo, hero, gallery, products). `public` needs `php artisan storage:link`;
# `media` is S3-compatible object storage (MinIO), see docs/06-integrations/minio.md.
WEBSITE_MEDIA_DISK=public
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
MEDIA_BUCKET=autowave-public
MEDIA_ENDPOINT=http://127.0.0.1:9000
MEDIA_URL=

# --- Queue / Cache (Redis) ----------------------------------------------------
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=autowave_cache_

# predis is used because the phpredis extension is not readily available on Windows dev machines.
# Production may switch to phpredis (REDIS_CLIENT=phpredis) once the extension is installed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Databases for queues and cache; production uses 2 and 3 because its Redis is shared.
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=autowave_database_

# --- Mail ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@autowave.in"
MAIL_FROM_NAME="${APP_NAME}"

# --- Messaging (config/messaging.php, ADR-018) ---------------------------------
# Fallback providers for businesses that have not connected WhatsApp/Instagram in
# Settings → Messaging (log = simulated). Meta tokens are per business, stored
# encrypted in the database — never put them here.
MESSAGING_WHATSAPP_PROVIDER=log
MESSAGING_INSTAGRAM_PROVIDER=log
MESSAGING_EMAIL_PROVIDER=mail
META_GRAPH_VERSION=v21.0

# --- AI (config/ai.php, ADR-019) ---------------------------------------------
# openrouter (needs OPENROUTER_API_KEY) or fake (sample answers, no network).
# The key is server-side only. Queue workers must listen on AI_QUEUE.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Seconds. Above 30, also raise REDIS_QUEUE_RETRY_AFTER and Nginx fastcgi_read_timeout
# (docs/06-integrations/openrouter.md#slow-and-free-models).
OPENROUTER_TIMEOUT=30
# off | low | medium | high; empty = the model's default.
OPENROUTER_REASONING=
AI_MONTHLY_TOKENS=300000
AI_AUTO_EXTRACT=true
AI_QUEUE=ai

# --- Object storage (optional, not used yet) ----------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Frontend -----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
